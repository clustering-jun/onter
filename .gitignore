# 원자료·가공 자료는 올리지 않는다(용량, 내부 전용 자료 포함)
/data/
/design/
/knowledge_graph/data/
/model/expert_request/

# 모델 산출물은 LLM 문장만 올린다. 나머지는 run_all.py로 다시 만든다
/model/outputs/*
!/model/outputs/llm/
/model/outputs/llm/*sample*
/model/outputs/llm/*.log

# 실행 중 생기는 파일
__pycache__/
*.pyc
/platform/data/user_state.json
/platform/data/*.tmp
/platform/data/llm_generated/run.log

# API 키
/.secrets/
